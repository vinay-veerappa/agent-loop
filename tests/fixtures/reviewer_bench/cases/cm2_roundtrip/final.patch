+            JObject NormalizeJObject(JObject source, string fallbackLeader, string fallbackGroupName)
+            {
+                var normalized = new JObject();
+
+                foreach (var prop in source.Properties())
+                {
+                    if (!aliasMap.ContainsKey(prop.Name))
+                        normalized[prop.Name] = prop.Value;
+                }
+
+                foreach (var prop in source.Properties())
+                {
+                    if (aliasMap.TryGetValue(prop.Name, out string canonical))
+                    {
+                        if (normalized[canonical] == null || normalized[canonical].Type == JTokenType.Null)
+                            normalized[canonical] = prop.Value;
+                    }
+                }
+
+                var defaults = new JObject
+                {
+                    ["Id"] = Guid.NewGuid().ToString(),
+                    ["IsEnabled"] = true,
+                    ["ArmedForLive"] = false,
+                    ["QuantityRatio"] = 1.0,
+                    ["FixedLotMode"] = false,
+                    ["FixedLotSize"] = 1,
+                    ["AutoSymbolConversion"] = true,
+                    ["MaxPositionSize"] = 100,
+                    ["DailyLossLimit"] = 1000.0,
+                    ["MaxSlippageTicks"] = 0.0,
+                    ["IsQuarantined"] = false,
+                    ["PerTickerRatios"] = new JObject(),
+                    ["CustomSymbolMappings"] = new JObject(),
+                    ["FollowerAccounts"] = new JArray()
+                };
+
+                foreach (var prop in defaults.Properties())
+                {
+                    if (normalized[prop.Name] == null || normalized[prop.Name].Type == JTokenType.Null)
+                        normalized[prop.Name] = prop.Value;
+                }
+
+                if (fallbackLeader != null && (normalized["LeaderAccountName"] == null || normalized["LeaderAccountName"].Type == JTokenType.Null))
+                    normalized["LeaderAccountName"] = fallbackLeader;
+                if (fallbackGroupName != null && (normalized["GroupName"] == null || normalized["GroupName"].Type == JTokenType.Null))
+                    normalized["GroupName"] = fallbackGroupName;
+
+                return normalized;
+            }
+
+            CopierRelationship ParseRelationship(JObject source, string key)
+            {
+                var normalized = NormalizeJObject(source, fallbackLeader: key, fallbackGroupName: null);
+                var rel = JsonConvert.DeserializeObject<CopierRelationship>(normalized.ToString(), settings);
+                if (rel == null)
+                    return null;
+                if (string.IsNullOrEmpty(rel.Id))
+                    rel.Id = Guid.NewGuid().ToString();
+                if (string.IsNullOrEmpty(rel.LeaderAccountName))
+                    rel.LeaderAccountName = key.Contains("_") ? key.Split('_')[0] : key;
+                if (string.IsNullOrEmpty(rel.FollowerAccountName))
+                    rel.FollowerAccountName = key.Contains("_") ? key.Split('_')[1] : "SimCopy2";
+                return rel;
+            }
+
+            CopierGroup ParseGroup(JObject source, string key)
+            {
+                var normalized = NormalizeJObject(source, fallbackLeader: null, fallbackGroupName: key);
+                var grp = JsonConvert.DeserializeObject<CopierGroup>(normalized.ToString(), settings);
+                if (grp == null)
+                    return null;
+                if (string.IsNullOrEmpty(grp.Id))
+                    grp.Id = Guid.NewGuid().ToString();
+                if (string.IsNullOrEmpty(grp.GroupName))
+                    grp.GroupName = key;
+                if (string.IsNullOrEmpty(grp.LeaderAccountName))
+                    grp.LeaderAccountName = "Sim101";
+                if (grp.FollowerAccounts == null)
+                    grp.FollowerAccounts = new List<string>();
+                return grp;
+            }
         }
 
